# 将本文件复制为 .streamlit/secrets.toml，去掉需要使用的配置行前面的 #，再填入实际值。
# secrets.toml 已被 .gitignore 忽略；不要将真实 API Key 写入本示例或提交到 Git。
# 文本与图片模型共用 DASHSCOPE_API_KEY；API Key 优先读取环境变量，再读取 secrets.toml。
# 模型名优先读取 secrets.toml，再读取环境变量；两处均未配置时使用代码默认值。
# 下列模型名称是配置示例；图片代码默认值仍为 qwen-vl-plus。

# DASHSCOPE_API_KEY = "你的百炼 DashScope API Key"
# DASHSCOPE_MODEL = "qwen3.7-plus"
# DASHSCOPE_VISION_MODEL = "qwen3-vl-plus"
