# 方案 A＝DeepSeek 文本＋图片：deepseek-v4.1-flash-1017 / deepseek-v4.1-flash-1017。
# 方案 A 配置示例：
# 下列为示例型号，不是固定白名单。同家族可以独立更改文本和图片型号。
# 例如文本填 deepseek-v4.1-flash，图片填 deepseek-v4.1-flash-1017。
# 程序原样发送配置的名称；模型是否存在、有权限及支持对应输入，由服务端验证。
# DASHSCOPE_MODEL = "deepseek-v4.1-flash-1017"
# DASHSCOPE_VISION_MODEL = "deepseek-v4.1-flash-1017"
# DASHSCOPE_API_KEY = ""
# DEEPSEEK_BASE_URL = "https://你的业务空间ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1"
# A 必须配置实际地域和业务空间对应的完整地址；上述为北京示例，不能直接保留占位符。
# C 不需要 DEEPSEEK_BASE_URL。两套实现都使用现有安全配置读取 DASHSCOPE_API_KEY。
# 方案 C＝现有千问文本＋图片：qwen3.7-max / qwen3-vl-plus。
# 复制本文件为 secrets.toml，然后填写 Key；文本和图片须同属 DeepSeek 或千问。
DASHSCOPE_MODEL = "qwen3.7-max"
DASHSCOPE_VISION_MODEL = "qwen3-vl-plus"
DASHSCOPE_API_KEY = ""
# 将本文件复制为 .streamlit/secrets.toml，去掉需要使用的配置行前面的 #，再填入实际值。
# secrets.toml 已被 .gitignore 忽略；不要将真实 API Key 写入本示例或提交到 Git。
# 文本与图片模型共用 DASHSCOPE_API_KEY；API Key 优先读取环境变量，再读取 secrets.toml。
# 模型名优先读取 secrets.toml，再读取环境变量；缺失、错误或混用时拒绝运行。

# DASHSCOPE_API_KEY = "你的百炼 DashScope API Key"
# A SDK：安装 requirements.txt 中的 openai；它访问百炼地址，不使用 OpenAI 的 Key。
